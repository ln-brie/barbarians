{% extends 'base.html.twig' %}

{% block title %}Hello FormController!
{% endblock %}

{% block body %}

	<div class="example-wrapper container">

		<div id="stats_form form">
			{{ form(form) }}
			</div>

		</div>
	{% endblock %}

	{% block success_stream %}
		<twig:Turbo:Stream:Replace target="#stats_form">

			The element having the id "my_div_id" will be replaced by this block, without a full page reload!

		</twig:Turbo:Stream:Replace>

	{% endblock %}
